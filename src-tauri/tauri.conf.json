{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumo-Hub",
  "version": "0.0.1-beta.0",
  "identifier": "com.lumohub.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lumo-Hub",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "dragDropEnabled": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Lumo-Hub",
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENDIxMjcyODlGNDE5NjcKUldSbkdmU0pjaEpDYmI1T3hHWldrQlJHb21KUVExV3BxaUtRV1pZeHU5NCtXQ29ScUVqWCtBamUK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/yeyongzhi/Lumo-Hub/releases/latest/download/latest.json"
      ]
    }
  }
}
